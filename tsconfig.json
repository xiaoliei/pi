{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@xiaoliyo/pi-telemetry": ["./packages/telemetry/src/index.ts"],
			"@xiaoliyo/pi-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@xiaoliyo/pi-ai": ["./packages/ai/src/index.ts"],
			"@xiaoliyo/pi-ai/*": ["./packages/ai/src/*.ts"],
			"@xiaoliyo/pi-ai/dist/*": ["./packages/ai/src/*"],
			"@xiaoliyo/pi-agent-core": ["./packages/agent/src/index.ts"],
			"@xiaoliyo/pi-agent-core/node": ["./packages/agent/src/node.ts"],
			"@xiaoliyo/pi-agent-core/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@xiaoliyo/pi-agent-core/*": ["./packages/agent/src/*"],
			"@xiaoliyo/pi-session-backend-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@xiaoliyo/pi-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@xiaoliyo/pi-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@xiaoliyo/pi-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@xiaoliyo/pi-protocol": ["./packages/protocol/src/index.ts"],
			"@xiaoliyo/pi-protocol/*": ["./packages/protocol/src/*"],
			"@xiaoliyo/pi-client": ["./packages/client/src/index.ts"],
			"@xiaoliyo/pi-client/*": ["./packages/client/src/*"],
			"@xiaoliyo/pi-server": ["./packages/server/src/index.ts"],
			"@xiaoliyo/pi-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@xiaoliyo/pi-tui": ["./packages/tui/src/index.ts"],
			"@xiaoliyo/pi-tui/*": ["./packages/tui/src/*"],
			"@xiaoliyo/pi-agent-old": ["./packages/agent-old/src/index.ts"],
			"@xiaoliyo/pi-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/session-backends/*/src/**/*", "packages/session-backends/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
